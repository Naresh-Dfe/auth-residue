# Choose distinct, synthetic test account values. These variables must also be
# exported in the shell running AuthResidue. No real accounts or production secrets.
AUTHRESIDUE_A_EMAIL=
AUTHRESIDUE_A_PASSWORD=
AUTHRESIDUE_B_EMAIL=
AUTHRESIDUE_B_PASSWORD=
# secure | cache-leak | broken-logout | public-api | stale-tab
AUTHRESIDUE_DEMO_MODE=secure
NEXT_TELEMETRY_DISABLED=1
